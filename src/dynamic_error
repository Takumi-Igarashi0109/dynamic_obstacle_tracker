void DynamicObstacleTracker::update_last_observation(int object_id, const geometry_msgs::PoseStamped& new_pose)
{
    last_observation_[object_id].last_pose = new_pose;
    last_observation_[object_id].last_time = new_pose.header.stamp;
}

// 物体の最後の位置と時間を取得するメソッド
bool DynamicObstacleTracker::get_last_observation(int object_id, geometry_msgs::PoseStamped& pose, ros::Time& timestamp)
{
    if (last_observation_.find(object_id) != last_observation_.end())
    {
        pose = last_observation_[object_id].last_pose;
        timestamp = last_observation_[object_id].last_time;
        return true;
    }
    return false;
}

// 物体の速度を計算し、観測時間と速度の合計を更新するメソッド
bool DynamicObstacleTracker::calculate_velocity_and_update(int object_id, const geometry_msgs::PoseStamped& current_pose, const ros::Time& current_time)
{
    geometry_msgs::PoseStamped last_pose;
    ros::Time last_time;
    
    if (get_last_observation(object_id, last_pose, last_time))
    {
        // 時間差を計算
        ros::Duration time_diff = current_time - last_time;
        if (time_diff.toSec() > 0.0)
        {
            // 移動距離を計算
            float distance = sqrt(pow(current_pose.pose.position.x - last_pose.pose.position.x, 2) +
                                  pow(current_pose.pose.position.y - last_pose.pose.position.y, 2));

            // 速度を計算（距離 / 時間）
            float velocity = distance / time_diff.toSec();

            // 観測時間と速度の合計を更新
            last_observation_[object_id].total_observed_time += time_diff.toSec();
            last_observation_[object_id].total_velocity += velocity;
        }
    }
}

bool DynamicObstacleTracker::is_same_object(const geometry_msgs::PoseStamped &pose1,const geometry_msgs::PoseStamped &pose2,float distance_threshold, float velocity_threshold)
{
    bool within_distance = is_within_distance_constraint(pose1.pose, pose2.pose, distance_threshold);
    bool within_velocity = is_within_velocity_constraint(pose1, pose2, velocity_threshold);
    return within_distance && within_velocity;
}

bool DynamicObstacleTracker::is_within_distance_constraint(const geometry_msgs::Pose &pose1,const geometry_msgs::Pose &pose2,float distance_threshold)
{
    float distance = sqrt(pow(pose1.position.x - pose2.position.x, 2) + pow(pose1.position.y - pose2.position.y, 2));
    return distance < distance_threshold;
}

bool DynamicObstacleTracker::is_within_velocity_constraint(const geometry_msgs::PoseStamped &pose1,const geometry_msgs::PoseStamped &pose2,float velocity_threshold)
{
    ros::Duration time_diff = pose2.header.stamp - pose1.header.stamp;
    if (time_diff.toSec() <= 0.0)
    {
        return true;
    }

    float distance = sqrt(pow(pose1.pose.position.x - pose2.pose.position.x, 2) +
                          pow(pose1.pose.position.y - pose2.pose.position.y, 2));

    float velocity = distance / time_diff.toSec();
    return velocity < velocity_threshold;
}

void DynamicObstacleTracker::visualize_trajectories(const std::vector<nav_msgs::Path> &paths)
{
    visualization_msgs::MarkerArray v_trajectories;
    for (size_t i = 0; i < paths.size(); i++)
    {
        if (paths[i].poses.size() < 2)
            continue;

        std_msgs::ColorRGBA color = path_colors_[i];
        visualization_msgs::Marker v_trajectory = create_marker_msg(i, 0.1, color, paths[i]);
        v_trajectories.markers.push_back(v_trajectory);
    }

    if (!v_trajectories.markers.empty())
        paths_pub_.publish(v_trajectories);
}

visualization_msgs::Marker DynamicObstacleTracker::create_marker_msg(const int id, const double scale, const std_msgs::ColorRGBA color, const nav_msgs::Path &path)
{
    visualization_msgs::Marker marker;
    marker.header = path.header;
    marker.id = id;
    marker.type = visualization_msgs::Marker::LINE_STRIP;
    marker.action = visualization_msgs::Marker::ADD;
    marker.pose.orientation.w = 1;
    marker.scale.x = scale;
    marker.color = color;
    marker.color.a = 1;
    marker.lifetime = ros::Duration(0.1);

    // 名前空間を物体ごとに設定（例えば "Obstacle_1", "Obstacle_2" など）
    marker.ns = "Obstacle_" + std::to_string(id);  // 物体のIDでユニークな名前空間を設定

    geometry_msgs::Point p;
    for (const auto &pose : path.poses)
    {
        p.x = pose.pose.position.x;
        p.y = pose.pose.position.y;
        marker.points.push_back(p);
    }

    return marker;
}

std_msgs::ColorRGBA DynamicObstacleTracker::generate_random_color()
{
    std_msgs::ColorRGBA color;
    color.r = static_cast<float>(rand()) / static_cast<float>(RAND_MAX);
    color.g = static_cast<float>(rand()) / static_cast<float>(RAND_MAX);
    color.b = static_cast<float>(rand()) / static_cast<float>(RAND_MAX);
    color.a = 1.0;
    return color;
}

int DynamicObstacleTracker::get_obstacle_id(const Eigen::Vector4f &centroid)
{
    std::tuple<float, float> position = std::make_tuple(centroid[0], centroid[1]);

    if (obstacle_ids_.find(position) != obstacle_ids_.end())
    {
        return obstacle_ids_[position];
    }
    else
    {
        int id = obstacle_ids_.size() + 1;
        obstacle_ids_[position] = id;
        return id;
    }
}

